{
  "name": "library-api",
  "version": "1.0.0",
  "description": "A learning-oriented Library Management REST API",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node-pg-migrate --migrations-dir database/migrations up",
    "db:migrate:down": "node-pg-migrate --migrations-dir database/migrations down",
    "db:seed": "node database/seeds/development.js"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "node-pg-migrate": "^9.0.0"
  }
}
